{"name":"entity.create","summary":"Create an entity, optionally with a parent, a position among its siblings and components.","scope":"edit:scene","idempotent":false,"destructive":false,"params":"EntityCreateParams","fields":[{"name":"id","typeHtml":"option&lt;string&gt;","doc":"ID of the new entity: a symbol (<code>$crate</code>) that later calls in the batch can use, or a concrete unused record ID. Minted when absent.","default":"null"},{"name":"name","typeHtml":"option&lt;string&gt;","doc":"Display name.","default":"null"},{"name":"parent","typeHtml":"option&lt;entity&gt;","doc":"Parent entity; absent creates a root. May be inside a prefab instance.","default":"null"},{"name":"index","typeHtml":"option&lt;u32&gt;","doc":"Position among the parent&#39;s children; absent appends.","default":"null"},{"name":"components","typeHtml":"option&lt;map&lt;json&gt;&gt;","doc":"Components to add, by type name; <code>{}</code> uses every default.","default":"null"}],"examples":[{"json":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"cmd\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"entity.create\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"args\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"id\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"$crate\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"name\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"Crate\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"components\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">      \"Transform\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">        \"position\"</span><span style=\"color:var(--code-fg)\">: [</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">          2</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">          0</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">          3</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">        ]</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">      }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">    }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">}</span></span></code></pre>","cli":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> entity.create </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">args </span><span style=\"color:var(--code-string)\">'{\"id\":\"$crate\",\"name\":\"Crate\",\"components\":{\"Transform\":{\"position\":[2,0,3]}}}'</span><span style=\"color:var(--code-keyword)\"> --</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"…\"</span></span></code></pre>"},{"json":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"cmd\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"entity.create\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"args\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"name\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"Lid\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"parent\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"$crate\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"index\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-number)\">0</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">}</span></span></code></pre>","cli":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> entity.create </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">args </span><span style=\"color:var(--code-string)\">'{\"name\":\"Lid\",\"parent\":\"$crate\",\"index\":0}'</span><span style=\"color:var(--code-keyword)\"> --</span><span style=\"color:var(--code-fg)\">why </span><span sty