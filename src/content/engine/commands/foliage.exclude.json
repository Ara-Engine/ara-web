{"name":"foliage.exclude","summary":"Exclude manual and procedural foliage from a circular zone.","scope":"edit:scene","idempotent":false,"destructive":false,"params":"FoliageExcludeParams","fields":[{"name":"id","typeHtml":"option&lt;string&gt;","doc":"Optional concrete or symbolic exclusion ID for reproducible authoring.","default":"null"},{"name":"zone","typeHtml":"<a href=\"/docs/reference/types/FoliageExclusion\">FoliageExclusion</a>","doc":"Circular exclusion zone.","required":true}],"examples":[{"json":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"cmd\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"foliage.exclude\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"args\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"zone\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">      \"center\"</span><span style=\"color:var(--code-fg)\">: [</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">        10</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">        20</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">      ],</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">      \"radius\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-number)\">4</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">    }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-f