{"name":"foliage.paint","summary":"Record one complete manual foliage brush gesture.","scope":"edit:scene","idempotent":false,"destructive":false,"params":"FoliagePaintParams","fields":[{"name":"stroke","typeHtml":"<a href=\"/docs/reference/types/FoliagePaint\">FoliagePaint</a>","doc":"Whole gesture, with all points in order.","required":true}],"examples":[{"json":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"cmd\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"foliage.paint\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"args\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"stroke\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">      \"rule\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"r_grass\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">      \"seed\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-number)\">42</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">      \"points\"</span><span style=\"color:var(--code-fg)\">: [</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">        [</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">          0</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">          0</spa