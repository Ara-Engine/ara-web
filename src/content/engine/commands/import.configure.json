{"name":"import.configure","summary":"Configure a source&#39;s import settings and refresh its installed importer version.","scope":"edit:scene","idempotent":false,"destructive":false,"params":"ImportConfigureParams","fields":[{"name":"source","typeHtml":"string","doc":"Source media path whose existing sidecar should change.","required":true},{"name":"settings","typeHtml":"option&lt;json&gt;","doc":"Replacement importer-specific settings; omitted retains them.","default":"null"},{"name":"preset","typeHtml":"option&lt;<a href=\"/docs/reference/types/CookPreset\">CookPreset</a>&gt;","doc":"Replacement shipping preset; omitted retains it.","default":"null","options":["balanced","highQuality","fast"]},{"name":"useProjectPreset","typeHtml":"bool","doc":"Remove the source quality override and follow the project import policy.","default":"false"},{"name":"dependencies","typeHtml":"option&lt;list&lt;asset&gt;&gt;","doc":"Replacement authoring dependencies; omitted retains them.","default":"null"}],"examples":[{"json":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"cmd\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"import.configure\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"args\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"source\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"models/crate.glb\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"settings\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">      \"lodCount\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-number)\">3</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">    }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">}</span></span></code></pre>","cli":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> import.configure </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">args </span><span style=\"color:var(--code-string)\">'{\"source\":\"models/crate.glb\",\"settings\":{\"lodCount\":3}}'</span><span style=\"color:var(--code-keyword)\"> --</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"…\"</span></span></code></pre>"}]}
