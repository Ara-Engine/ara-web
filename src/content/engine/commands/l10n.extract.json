{"name":"l10n.extract","summary":"Scan UI/C# literals into reviewed key proposals and undoable table ops.","scope":"edit:l10n","idempotent":false,"destructive":false,"params":"L10nExtractParams","fields":[{"name":"kind","typeHtml":"<a href=\"/docs/reference/types/L10nSourceKind\">L10nSourceKind</a>","doc":"UI markup or C#.","options":["markup","csharp"],"required":true},{"name":"source","typeHtml":"string","doc":"Complete UTF-8 source text.","required":true},{"name":"prefix","typeHtml":"string","doc":"Dotted prefix for generated stable keys, for example <code>pause</code>.","required":true}],"examples":[{"json":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"cmd\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"l10n.extract\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"args\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"kind\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"markup\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"source\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"&#x3C;ui>&#x3C;label text='Resume'/>&#x3C;/ui>\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"prefix\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"pause\"</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">}</span></span></code></pre>","cli":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> l10n.extract </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">args </span><span style=\"color:var(--code-string)\">'{\"kind\":\"markup\",\"source\":\"&#x3C;ui>&#x3C;label text='</span><span style=\"color:var(--code-fg)\">Resume</span><span style=\"color:var(--code-string)\">'/>&#x3C;/ui>\",\"prefix\":\"pause\"}'</span><span style=\"color:var(--code-keyword)\"> --</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"…\"</span></span></code></pre>"}]}
