{"name":"l10n.put","summary":"Insert or replace a typed localization message.","scope":"edit:l10n","idempotent":false,"destructive":false,"params":"L10nPutParams","fields":[{"name":"id","typeHtml":"option&lt;string&gt;","doc":"Existing record ID, or omit to reuse the key&#39;s record or a stable hashed ID.","default":"null"},{"name":"entry","typeHtml":"<a href=\"/docs/reference/types/L10nStringEntry\">L10nStringEntry</a>","doc":"Whole message with typed parameters and review metadata.","required":true}],"examples":[{"json":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"cmd\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"l10n.put\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"args\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"entry\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">      \"key\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"menu.resume\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">      \"text\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"Resume\"</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">    }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">}</span></span></code></pre>","cli":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> l10n.put </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">args </span><span style=\"color:var(--code-string)\">'{\"entry\":{\"key\":\"menu.resume\",\"text\":\"Resume\"}}'</span><span style=\"color:var(--code-keyword)\"> --</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"…\"</span></span></code></pre>"}]}
