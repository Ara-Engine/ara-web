{"name":"physics.collider.fromModel","summary":"Derive convex or static mesh collision from cooked model geometry.","scope":"edit:scene","idempotent":false,"destructive":false,"params":"ColliderFromModelParams","fields":[{"name":"entity","typeHtml":"entity","doc":"Target entity, including prefab addresses.","required":true},{"name":"model","typeHtml":"option&lt;asset&gt;","doc":"Source import; omitted uses MeshRenderer.model.","default":"null"},{"name":"node","typeHtml":"option&lt;string&gt;","doc":"Source node name/index; omitted inherits MeshRenderer.node when model is omitted.","default":"null"},{"name":"primitive","typeHtml":"option&lt;u32&gt;","doc":"Subtree-local primitive; omitted inherits MeshRenderer.primitive when model is omitted.","default":"null"},{"name":"mode","typeHtml":"<a href=\"/docs/reference/types/ModelColliderMode\">ModelColliderMode</a>","doc":"Convex hull by default, or a static triangle surface.","default":"\"convex\"","options":["convex","mesh"]},{"name":"center","typeHtml":"option&lt;vec3&gt;","doc":"Optional center in body-local metres, after visual scale is baked.","default":"null"}],"examples":[{"json":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"cmd\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"physics.collider.fromModel\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"args\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"entity\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"e_crate\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"mode\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"convex\"</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">}</span></span></code></pre>","cli":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> physics.collider.fromModel </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">args </span><span style=\"color:var(--code-string)\">'{\"entity\":\"e_crate\",\"mode\":\"convex\"}'</span><span style=\"color:var(--code-keyword)\"> --</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"…\"</span></span></code></pre>"},{"json":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"cmd\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"physics.collider.fromModel\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"args\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"entity\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"e_wall\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"mode\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"mesh\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"center\"</span><span style=\"color:var(--code-fg)\">: [</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">      0</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">      0.5</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">      0</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">    ]</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">}</span></span></code></pre>","cli":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> physics.collider.fromModel </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">args </span><span style=\"color:var(--code-string)\">'{\"entity\":\"e_wall\",\"mode\":\"mesh\",\"center\":[0,0.5,0]}'</span><span style=\"color:var(--code-keyword)\"> --</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"…\"</span></span></code></pre>"}]}
