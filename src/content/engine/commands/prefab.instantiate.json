{"name":"prefab.instantiate","summary":"Place an instance of a prefab; its content stays linked to the prefab.","scope":"edit:scene","idempotent":false,"destructive":false,"params":"PrefabInstantiateParams","fields":[{"name":"prefab","typeHtml":"asset&lt;prefab&gt;","doc":"The prefab, as <code>@path#id</code>, <code>@path</code> or <code>@#id</code>.","required":true},{"name":"id","typeHtml":"option&lt;string&gt;","doc":"ID of the instance: a symbol (<code>$door</code>) or a concrete unused record ID. Minted when absent.","default":"null"},{"name":"name","typeHtml":"option&lt;string&gt;","doc":"Display name; absent keeps the prefab root&#39;s name.","default":"null"},{"name":"parent","typeHtml":"option&lt;entity&gt;","doc":"Parent entity; absent creates a root.","default":"null"},{"name":"index","typeHtml":"option&lt;u32&gt;","doc":"Position among the parent&#39;s children; absent appends.","default":"null"},{"name":"position","typeHtml":"option&lt;vec3&gt;","doc":"Local position of the instance.","default":"null","unit":"m"}],"examples":[{"json":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"cmd\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"prefab.instantiate\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"args\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"prefab\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"@prefabs/crate.prefab\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"id\"</span><span style=\"colo