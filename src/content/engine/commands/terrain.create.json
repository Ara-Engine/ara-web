{"name":"terrain.create","summary":"Create a tiled terrain grid in an empty terrain document.","scope":"edit:scene","idempotent":false,"destructive":false,"params":"TerrainCreateParams","fields":[{"name":"grid","typeHtml":"<a href=\"/docs/reference/types/TerrainHeader\">TerrainHeader</a>","doc":"Terrain grid dimensions and material channels.","required":true}],"examples":[{"json":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"cmd\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"terrain.create\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"args\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"grid\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">      \"origin\"</span><span style=\"color:var(--code-fg)\">: [</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">        0</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">        0</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">      ],</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">      \"spacing\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-number)\">1</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">      \"cells\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-number)\">64</span><span style=\"color:var(--code-fg)\">,<