{"name":"terrain.paint","summary":"Paint normalized material weights for a complete gesture.","scope":"edit:scene","idempotent":false,"destructive":false,"params":"TerrainStrokeParams","fields":[{"name":"id","typeHtml":"option&lt;string&gt;","doc":"Optional concrete or symbolic stroke ID for reproducible authoring.","default":"null"},{"name":"layer","typeHtml":"string","doc":"Existing layer ID.","required":true},{"name":"dabs","typeHtml":"list&lt;<a href=\"/docs/reference/types/TerrainDab\">TerrainDab</a>&gt;","doc":"Ordered gesture samples.","required":true},{"name":"channel","typeHtml":"option&lt;u32&gt;","doc":"Material channel for paint; defaults to zero.","default":"null"},{"name":"iterations","typeHtml":"option&lt;u32&gt;","doc":"Thermal iterations, default eight.","default":"null"},{"name":"stamp","typeHtml":"option&lt;string&gt;","doc":"Immutable height stamp hash.","default":"null"},{"name":"angle","typeHtml":"option&lt;f32&gt;","doc":"Stamp rotation in radians.","default":"null"}],"examples":[{"json":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"cmd\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"terrain.paint\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"args\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"layer\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"l_base\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"dabs\"</span><span style=\"color:var(--code-fg)\">: [</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">      {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">        \"center\"</span><span style=\"color:var(--code-fg)\">: [</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">          0</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">          0</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">        ],</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">        \"radius\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-number)\">8</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">        \"amount\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-number)\">1</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">      }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">    ]</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">}</span></span></code></pre>","cli":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> terrain.paint </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">args </span><span style=\"color:var(--code-string)\">'{\"layer\":\"l_base\",\"dabs\":[{\"center\":[0,0],\"radius\":8,\"amount\":1}]}'</span><span style=\"color:var(--code-keyword)\"> --</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"…\"</span></span></code></pre>"}]}
