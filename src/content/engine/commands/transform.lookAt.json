{"name":"transform.lookAt","summary":"Aim local -Z at a world point or entity with a preferred world up vector.","scope":"edit:scene","idempotent":true,"destructive":false,"params":"TransformLookAtParams","fields":[{"name":"entity","typeHtml":"entity","doc":"Camera, light or other entity whose local -Z axis should face the target.","required":true},{"name":"point","typeHtml":"option&lt;vec3&gt;","doc":"World-space target position. Supply exactly one of point or target.","default":"null","unit":"m"},{"name":"target","typeHtml":"option&lt;entity&gt;","doc":"Target entity in this document; its world position is used.","default":"null"},{"name":"up","typeHtml":"option&lt;vec3&gt;","doc":"Preferred world-space up vector; defaults to +Y. At a pole a stable perpendicular axis is used.","default":"null"}],"examples":[{"json":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"cmd\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"transform.lookAt\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"args\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"entity\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"e_camera\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"point\"</span><span style=\"color:var(--code-fg)\">: [</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">      0</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">      1</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">      0</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">    ],</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"up\"</span><span style=\"color:var(--code-fg)\">: [</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">      0</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">      1</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">      0</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">    ]</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">}</span></span></code></pre>","cli":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> transform.lookAt </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">args </span><span style=\"color:var(--code-string)\">'{\"entity\":\"e_camera\",\"point\":[0,1,0],\"up\":[0,1,0]}'</span><span style=\"color:var(--code-keyword)\"> --</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"…\"</span></span></code></pre>"}]}
