{"name":"transform.set","summary":"Set the local position, rotation and/or scale of entities.","scope":"edit:scene","idempotent":true,"destructive":false,"params":"TransformSetParams","fields":[{"name":"entities","typeHtml":"list&lt;entity&gt;","doc":"Entities to change; each gets a <code>Transform</code> if it has none.","required":true},{"name":"position","typeHtml":"option&lt;vec3&gt;","doc":"Position relative to the parent.","default":"null","unit":"m"},{"name":"rotation","typeHtml":"option&lt;vec3&gt;","doc":"Rotation relative to the parent, as XYZ Euler angles.","default":"null","unit":"deg"},{"name":"scale","typeHtml":"option&lt;vec3&gt;","doc":"Scale relative to the parent.","default":"null"}],"examples":[{"json":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"cmd\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"transform.set\"</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"args\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"entities\"</span><span style=\"color:var(--code-fg)\">: [</span></span>\n<span class=\"line\"><span style=\"color:var(--code-string)\">      \"e_8b21\"</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">    ],</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"position\"</span><span style=\"color:var(--code-fg)\">: [</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">      2</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">      0</span><span style=\"color:var(--co