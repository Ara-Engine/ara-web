span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-keyword)\">false</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">}</span></span></code></pre>","cli":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> vfx.module.enable </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">args </span><span style=\"color:var(--code-string)\">'{\"emitter\":\"flame\",\"stage\":\"update\",\"name\":\"curl\",\"enabled\":false}'</span><span style=\"color:var(--code-keyword)\"> --</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"…\"</span></span></code></pre>"}]}
