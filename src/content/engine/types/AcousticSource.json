{"name":"AcousticSource","kind":"component","module":"audio","doc":"Per-source acoustic behaviour, alongside <code>AudioSource</code>. Optional: sources without it use <code>AcousticSource::default()</code>.","fields":[{"name":"occlusion","typeHtml":"bool","doc":"Trace geometry between source and listener for occlusion and transmission.","default":"true"},{"name":"occlusionRadius","typeHtml":"f32","doc":"Radius sampled for partial (volumetric) occlusion; 0 traces only the center ray.","default":"0.5","unit":"m","range":"0 – 50"},{"name":"airAbsorption","typeHtml":"bool","doc":"Apply frequency-dependent air absorption over the propagation distance.","default":"true"},{"name":"doppler","typeHtml":"f32","doc":"Doppler strength: 0 disables pitch shift, 1 is physical, larger exaggerates.","default":"1","range":"0 – 4"},{"name":"reverbSend","typeHtml":"f32","doc":"Room reverb send before zone and portal attenuation.","default":"1","range":"0 – 1"},{"name":"distanceCurve","typeHtml":"list&lt;vec2&gt;","doc":"Custom distance curve: <code>[meters, linear gain]</code> points with increasing distance. Empty uses <code>AudioSource.attenuation</code>; cones still apply.","default":"[]"}],"variants":[],"usedBy":{"types":[],"commands":[]},"usage":[{"label":"Add it","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> component.add </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p component</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">AcousticSource </span><spa