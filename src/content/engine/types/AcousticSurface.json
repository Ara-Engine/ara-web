{"name":"AcousticSurface","kind":"component","module":"audio","doc":"Acoustic surface of static geometry or a collider. The physics ray adapter maps hit bodies to this component; absent components read as <code>generic</code>.","fields":[{"name":"preset","typeHtml":"<a href=\"/docs/reference/types/MaterialPreset\">MaterialPreset</a>","doc":"Named material; ignored when <code>custom</code> is set.","default":"\"generic\"","options":["generic","brick","concrete","ceramic","gravel","carpet","glass","plaster","wood","metal","rock"]},{"name":"custom","typeHtml":"option&lt;<a href=\"/docs/reference/types/AcousticMaterial\">AcousticMaterial</a>&gt;","doc":"Explicit material values overriding the preset.","default":"null"}],"variants":[],"usedBy":{"types":[],"commands":[]},"usage":[{"label":"Add it","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> component.add </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p component</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">AcousticSurface </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"Add AcousticSurface\"</span></span></code></pre>"},{"label":"Set a field","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> property.set </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p path</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">AcousticSurface.preset </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p value</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-string)\">\"generic\"</span><span style=\"color:var(--code-keyword)\"> --</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"Tune AcousticSurface\"</span></span></code></pre>"},{"label":"In a scene document","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"AcousticSurface\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"preset\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"generic\"</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">}</span></span></code></pre>"}]}
