{"name":"AudioSource","kind":"component","module":"audio","doc":"Declarative sound intent. Playback cursors and decoder state are presentation only.","fields":[{"name":"clip","typeHtml":"option&lt;asset&lt;audio&gt;&gt;","doc":"Cooked clip reference in <code>@path#id</code> form; absent means no clip.","default":"null"},{"name":"bus","typeHtml":"string","doc":"Mixer bus name resolved by the presentation bridge.","default":"\"master\""},{"name":"gain","typeHtml":"f32","doc":"Linear source amplitude.","default":"1","range":"0 – 16"},{"name":"pitch","typeHtml":"f32","doc":"Playback pitch multiplier before Doppler.","default":"1","range":"0.125 – 8"},{"name":"looping","typeHtml":"bool","doc":"Whether the clip repeats.","default":"false"},{"name":"spatial","typeHtml":"bool","doc":"Whether position affects the sound.","default":"true"},{"name":"priority","typeHtml":"u8","doc":"Voice budget priority; larger values are retained first.","default":"128"},{"name":"referenceDistance","typeHtml":"f32","doc":"Full-volume radius.","default":"1","unit":"m","range":"0.01 – 100000"},{"name":"maxDistance","typeHtml":"f32","doc":"Silent beyond this distance; must exceed referenceDistance.","default":"100","unit":"m","range":"0.02 – 1000000"},{"name":"attenuation","typeHtml":"<a href=\"/docs/reference/types/Attenuation\">Attenuation</a>","doc":"Shape of the distance attenuation curve.","default":"\"inverse\"","options":["inverse","linear","inverseSquare"]},{"name":"position","typeHtml":"vec3","doc":"Source position, supplied from the ECS world transform by the bridge.","default":"[0,0,0]","unit":"m"},{"name":"velocity","typeHtml":"vec3","doc":"Source velocity in meters per second for Doppler.","default":"[0,0,0]"},{"name":"forward","typeHtml":"vec3","doc":"Source forward axis; normalized during spatial evaluation.","default":"[0,0,-1]"},{"name":"coneInner","typeHtml":"f32","doc":"Full angle of the unattenuated source cone.","default":"360","unit":"deg","range":"0 – 360"},{"name":"coneOuter","typeHtml":"f32","doc":"Full angle at which the source reaches coneOuterGain.","default":"360","unit":"deg","range":"0 – 360"},{"name":"coneOuterGain","typeHtml":"f32","doc":"Linear amplitude outside the source cone.","default":"1","range":"0 – 1"}],"variants":[],"usedBy":{"types":[],"commands":[]},"usage":[{"label":"Add it","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> component.add </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p component</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">AudioSource </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"Add AudioSource\"</span></span></code></pre>"},{"label":"Set a field","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> property.set </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p path</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">AudioSource.clip </span><span style=\