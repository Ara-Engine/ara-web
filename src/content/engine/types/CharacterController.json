{"name":"CharacterController","kind":"component","module":"physics","doc":"Predicted capsule movement: slopes, stairs, moving platforms, crouching and pushing.","fields":[{"name":"radius","typeHtml":"f32","doc":"Standing capsule radius.","default":"0.3","unit":"m","range":"≥ 0.001"},{"name":"height","typeHtml":"f32","doc":"Complete standing height; must exceed twice the radius.","default":"1.8","unit":"m","range":"≥ 0.001"},{"name":"crouchHeight","typeHtml":"f32","doc":"Complete crouched height, between diameter and standing height.","default":"1","unit":"m","range":"≥ 0.001"},{"name":"maxSlopeDeg","typeHtml":"f32","doc":"Maximum walkable slope angle.","default":"45","unit":"deg","range":"0.1 – 89.9"},{"name":"stepHeight","typeHtml":"f32","doc":"Maximum stair step height.","default":"0.35","unit":"m","range":"≥ 0"},{"name":"stickDown","typeHtml":"f32","doc":"Distance searched below feet to stay on a descending surface.","default":"0.5","unit":"m","range":"≥ 0"},{"name":"padding","typeHtml":"f32","doc":"Capsule collision padding.","default":"0.02","unit":"m","range":"≥ 0"},{"name":"maxStrength","typeHtml":"f32","doc":"Maximum force used to push rigid bodies.","default":"1000","unit":"N","range":"≥ 0"},{"name":"mass","typeHtml":"f32","doc":"Character mass used for dynamic body interaction.","default":"70","unit":"kg","range":"≥ 0.001"},{"name":"layer","typeHtml":"u32","doc":"Collision group used for movement queries.","default":"1","range":"1 – 15"}],"variants":[],"usedBy":{"types":[],"commands":[]},"usage":[{"label":"Add it","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> component.add </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=<