{"name":"CharacterController2d","kind":"component","module":"physics2d","doc":"Kinematic capsule character: slopes, steps, ground snapping and pushing. The entity needs no RigidBody2d/Collider2d; the controller owns its capsule.","fields":[{"name":"radius","typeHtml":"f32","doc":"Capsule radius.","default":"0.3","unit":"m","range":"≥ 0.001"},{"name":"height","typeHtml":"f32","doc":"Complete capsule height; must exceed twice the radius.","default":"1.8","unit":"m","range":"≥ 0.001"},{"name":"maxSlopeDeg","typeHtml":"f32","doc":"Maximum walkable slope angle.","default":"45","unit":"deg","range":"0.1 – 89.9"},{"name":"stepHeight","typeHtml":"f32","doc":"Maximum step height climbed automatically; zero disables stepping.","default":"0.25","unit":"m","range":"≥ 0"},{"name":"stickDown","typeHtml":"f32","doc":"Distance searched below the feet to stay on descending ground; zero disables it.","default":"0.2","unit":"m","range":"≥ 0"},{"name":"padding","typeHtml":"f32","doc":"Collision padding kept between the capsule and the world.","default":"0.01","unit":"m","range":"≥ 0.0001"},{"name":"layer","typeHtml":"u32","doc":"Collision group used for movement queries.","default":"1","range":"1 – 15"}],"variants":[],"usedBy":{"types":["Physics2dSetParams"],"commands":["physics2d.set"]},"usage":[{"label":"Add it","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> component.add </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p component</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">CharacterController2d </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"Add CharacterController2d\"</span></span></code></pre>"},{"label":"Set a field","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> property.set </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p path</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">CharacterController2d.radius </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p value</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-number)\">0.3</span><span style=\"color:var(--code-keyword)\"> --</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"Tune CharacterController2d\"</span></span></code></pre>"},{"label":"In a scene document","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"CharacterController2d\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"radius\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-number)\">0.3</span></span>\n<span class=\"line