{"name":"Collider2d","kind":"component","module":"physics2d","doc":"Collision geometry, material, layer and trigger settings for a <code>RigidBody2d</code>.","fields":[{"name":"kind","typeHtml":"<a href=\"/docs/reference/types/ColliderKind2d\">ColliderKind2d</a>","doc":"Primitive type or convex polygon.","default":"\"box\"","options":["box","circle","capsule","polygon"]},{"name":"halfExtents","typeHtml":"vec2","doc":"Box half extents; scale must be baked before physics extraction.","default":"[0.5,0.5]","unit":"m","range":"≥ 0.0001"},{"name":"radius","typeHtml":"f32","doc":"Circle or capsule radius.","default":"0.5","unit":"m","range":"≥ 0.0001"},{"name":"halfHeight","typeHtml":"f32","doc":"Capsule segment half height, excluding the end caps.","default":"0.5","unit":"m","range":"≥ 0"},{"name":"points","typeHtml":"list&lt;vec2&gt;","doc":"Local convex hull input for polygons, in metres.","default":"[]"},{"name":"layer","typeHtml":"u32","doc":"Zero selects static/moving defaults from the body; 1..15 select an explicit group.","default":"0","range":"0 – 15"},{"name":"sensor","typeHtml":"bool","doc":"Report overlaps without a collision response.","default":"false"},{"name":"friction","typeHtml":"f32","doc":"Coulomb friction coefficient.","default":"0.6","range":"≥ 0"},{"name":"restitution","typeHtml":"f32","doc":"Elasticity: zero is inelastic, one is perfectly elastic.","default":"0","range":"0 – 1"}],"variants":[],"usedBy":{"types":["Physics2dSetParams"],"commands":["physics2d.set"]},"usage":[{"label":"Add it","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> component.add </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style