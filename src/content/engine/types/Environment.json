{"name":"Environment","kind":"component","module":"render","doc":"Procedural sky radiance and camera exposure. The first in stable-ID order wins.","fields":[{"name":"sky","typeHtml":"color","doc":"Zenith sky color (linear).","default":"[0.22,0.32,0.6,1]"},{"name":"horizon","typeHtml":"color","doc":"Horizon sky color (linear).","default":"[0.95,0.62,0.4,1]"},{"name":"ground","typeHtml":"color","doc":"Ground color seen below the horizon (linear).","default":"[0.18,0.16,0.14,1]"},{"name":"intensity","typeHtml":"f32","doc":"Sky radiance scale in candela per square metre.","default":"900","unit":"cd","range":"≥ 0"},{"name":"exposure","typeHtml":"f32","doc":"Linear camera exposure multiplier, applied before tone mapping.","default":"0.0015","range":"≥ 1e-7"}],"variants":[],"usedBy":{"types":[],"commands":[]},"usage":[{"label":"Add it","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> component.add </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p component</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">Environment </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"Add Environment\"</span></span></code></pre>"},{"label":"Set a field","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> property.set </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p path</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">Environment.sky </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p value</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">[</span><span style=\"color:var(--code-number)\">0.22</span><span style=\"color:var(--code-keyword)\">,</span><span style=\"color:var(--code-number)\">0.32</span><span style=\"color:var(--code-keyword)\">,</span><span style=\"color:var(--code-number)\">0.6</span><span style=\"color:var(--code-keyword)\">,</span><span style=\"color:var(--code-number)\">1</span><span style=\"color:var(--code-fg)\">] </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"Tune Environment\"</span></span></code></pre>"},{"label":"In a scene document","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"Environment\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"sky\"</span><span style=\"color:var(--code-fg)\">: [</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">      0.22</span><span style=\"color:var(--code-fg)\">,</span></span>\n<span class=\"line\"><span style=\"color:var(--code-number)\">      0.32<