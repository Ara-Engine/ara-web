{"name":"Joint","kind":"component","module":"physics","doc":"Joint on a body; connection zero anchors to the world. Anchors/axes are world-space.","fields":[{"name":"kind","typeHtml":"<a href=\"/docs/reference/types/JointKind\">JointKind</a>","doc":"Constraint primitive.","default":"\"fixed\"","options":["fixed","hinge","slider","distance","point","sixDof"]},{"name":"connectedBody","typeHtml":"u64","doc":"PhysicsId of the connected body; zero is the world.","default":"0"},{"name":"anchorA","typeHtml":"vec3","doc":"Anchor on the connected body, or the world anchor.","default":"[0,0,0]","unit":"m"},{"name":"anchorB","typeHtml":"vec3","doc":"Anchor on this entity&#39;s body.","default":"[0,0,0]","unit":"m"},{"name":"axis","typeHtml":"vec3","doc":"Unit primary axis (hinge direction, slider direction, or frame X).","default":"[1,0,0]"},{"name":"normal","typeHtml":"vec3","doc":"Unit perpendicular normal (frame Y).","default":"[0,1,0]"},{"name":"translationMin","typeHtml":"vec3","doc":"Minimum XYZ translation; X is the slider/distance lower bound.","default":"[0,0,0]","unit":"m"},{"name":"translationMax","typeHtml":"vec3","doc":"Maximum XYZ translation; X is the slider/distance upper bound.","default":"[0,0,0]","unit":"m"},{"name":"rotationMin","typeHtml":"vec3","doc":"Minimum XYZ angular limits; X is the hinge lower bound.","default":"[0,0,0]","unit":"rad","range":"-3.1415928 – 3.1415928"},{"name":"rotationMax","typeHtml":"vec3","doc":"Maximum XYZ angular limits; X is the hinge upper bound.","default":"[0,0,0]","unit":"rad","range":"-3.1415928 – 3.1415928"}],"variants":[],"usedBy":{"types":[],"commands":[]},"usage":[{"label":"Add it","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> component.add </span><span style=\"color:var(--code-keyword)\