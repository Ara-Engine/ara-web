{"name":"Light","kind":"component","module":"render","doc":"A light at the entity&#39;s world position. Edits apply live in play.","fields":[{"name":"kind","typeHtml":"<a href=\"/docs/reference/types/LightKind\">LightKind</a>","doc":"Point, spot or directional.","default":"\"point\"","options":["point","spot","directional"]},{"name":"color","typeHtml":"color","doc":"Linear RGB tint (alpha is ignored).","default":"[1,1,1,1]"},{"name":"intensity","typeHtml":"f32","doc":"Luminous flux in lumens (point/spot) or illuminance in lux (directional).","default":"800","range":"≥ 0"},{"name":"range","typeHtml":"f32","doc":"Influence radius of point and spot lights.","default":"10","unit":"m","range":"≥ 0.01","showIf":"kind is point or spot"},{"name":"innerAngle","typeHtml":"f32","doc":"Spot inner cone half-angle.","default":"20","unit":"deg","range":"0 – 89","showIf":"kind is spot"},{"name":"outerAngle","typeHtml":"f32","doc":"Spot outer cone half-angle.","default":"30","unit":"deg","range":"0.1 – 89","showIf":"kind is spot"}],"variants":[],"usedBy":{"types":[],"commands":[]},"usage":[{"label":"Add it","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> component.add </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p component</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">Light </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"Add Light\"</span></span></code></pre>"},{"label":"Set a field","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> property.set </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p path</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">Light.kind </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p value</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-string)\">\"point\"</span><span style=\"color:var(--code-keyword)\"> --</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"Tune Light\"</span></span></code></pre>"},{"label":"In a scene document","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"Light\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"kind\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"point\"</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">}</span></span></code></pre>"}]}
