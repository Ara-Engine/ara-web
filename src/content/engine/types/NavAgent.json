{"name":"NavAgent","kind":"component","module":"navigation","doc":"Dimensions, speed and permitted areas of one navigation agent.","fields":[{"name":"profile","typeHtml":"u32","doc":"Mesh profile ID; radius and height must fit that profile.","default":"0"},{"name":"radius","typeHtml":"f32","doc":"Collision radius in metres.","default":"0.3","unit":"m","range":"0.001 – 10"},{"name":"height","typeHtml":"f32","doc":"Required clearance in metres.","default":"1.8","unit":"m","range":"0.01 – 100"},{"name":"maxSpeed","typeHtml":"f32","doc":"Maximum movement speed in metres per second.","default":"3","range":"0 – 1000"},{"name":"acceleration","typeHtml":"f32","doc":"Maximum change in velocity per second.","default":"8","range":"0 – 10000"},{"name":"areaMask","typeHtml":"u16","doc":"Areas this agent can use (one bit per area).","default":"65535"},{"name":"stoppingDistance","typeHtml":"f32","doc":"Arrival tolerance in metres.","default":"0.1","unit":"m","range":"0.001 – 10"}],"variants":[],"usedBy":{"types":[],"commands":[]},"usage":[{"label":"Add it","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> component.add </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p component</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">NavAgent </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"Add NavAgent\"</span></span></code></pre>"},{"label":"Set a field","html":"<pre c