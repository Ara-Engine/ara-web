{"name":"NavAgentType","kind":"component","module":"navigation","doc":"A named agent type: its own baked mesh (dimensions) and traversal costs. Agents select it through <code>NavAgent.profile == profile</code>.","fields":[{"name":"profile","typeHtml":"u32","doc":"Mesh profile ID shared by the type&#39;s agents and its bake.","default":"0"},{"name":"name","typeHtml":"string","doc":"Inspector name (Humanoid, Brute, Drone).","default":"\"\""},{"name":"radius","typeHtml":"f32","doc":"Bake radius in metres.","default":"0.3","unit":"m","range":"0.01 – 10"},{"name":"height","typeHtml":"f32","doc":"Bake clearance height in metres.","default":"1.8","unit":"m","range":"0.1 – 100"},{"name":"climb","typeHtml":"f32","doc":"Maximum step height in metres.","default":"0.4","unit":"m","range":"0 – 10"},{"name":"slope","typeHtml":"f32","doc":"Steepest walkable slope in degrees.","default":"45","unit":"deg","range":"0 – 89"},{"name":"areaCosts","typeHtml":"list&lt;f32&gt;","doc":"Cost multiplier per area ID (index 0..15); missing entries are 1.","default":"[]"},{"name":"areaMask","typeHtml":"u16","doc":"Areas this type may enter (one bit per area).","default":"65535"}],"variants":[],"usedBy":{"types":[],"commands":[]},"usage":[{"label":"Add it","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> component.add </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p component</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">NavAgentType </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"Add NavAgentType\"</span></span></code></pre>"},{"label":"Set a field","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> property.set </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p path</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">NavAgentType.profile </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p value</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-number)\">0</span><span style=\"color:var(--code-keyword)\"> --</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"Tune NavAgentType\"</span></span></code></pre>"},{"label":"In a scene document","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"NavAgentType\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"profile\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-number)\">0</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">}</span></span></code></pre>"}]}
