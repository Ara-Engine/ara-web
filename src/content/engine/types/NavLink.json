{"name":"NavLink","kind":"component","module":"navigation","doc":"Authored off-mesh connection in world space (jump, ladder or scripted passage).","fields":[{"name":"id","typeHtml":"u32","doc":"Stable nonzero connection ID.","default":"0"},{"name":"start","typeHtml":"vec3","doc":"Start endpoint in world space.","default":"[0,0,0]","unit":"m"},{"name":"end","typeHtml":"vec3","doc":"End endpoint in world space.","default":"[0,0,0]","unit":"m"},{"name":"radius","typeHtml":"f32","doc":"Maximum horizontal attachment distance.","default":"0.5","unit":"m","range":"0.001 – 100"},{"name":"area","typeHtml":"u8","doc":"Traversal area index, from 0 through 15.","default":"0","range":"0 – 15"},{"name":"bidirectional","typeHtml":"bool","doc":"Whether traversal is allowed in both directions.","default":"true"},{"name":"enabled","typeHtml":"bool","doc":"Whether the connection is available to the baker.","default":"true"},{"name":"kind","typeHtml":"<a href=\"/docs/reference/types/LinkKind\">LinkKind</a>","doc":"How agents traverse it: drives traversal motion, gating and animation hooks.","default":"\"walk\"","options":["walk","jump","ladder","door","elevator","teleport"]},{"name":"duration","typeHtml":"f32","doc":"Traversal time in seconds; 0 derives it from length and agent speed.","default":"0","unit":"s","range":"0 – 600"},{"name":"arcHeight","typeHtml":"f32","doc":"Jump apex above the straight start-end line, in metres (jumps only).","default":"0.5","unit":"m","range":"0 – 100"}],"variants":[],"usedBy":{"types":[],"commands":[]},"usage":[{"label":"Add it","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> component.add </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(-