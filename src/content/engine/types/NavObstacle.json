{"name":"NavObstacle","kind":"component","module":"navigation","doc":"Dynamic obstacle: an axis-aligned box centred on the entity&#39;s <code>NavPosition</code>. Carve/Area changes publish after <code>NavConfig::rebake_latency_ticks</code>; until then (and always for <code>Avoid</code>) agents avoid it locally.","fields":[{"name":"id","typeHtml":"u32","doc":"Stable nonzero ID; changes are canonically ordered by it.","default":"0"},{"name":"halfExtents","typeHtml":"vec3","doc":"Box half extents in metres.","default":"[0.5,0.5,0.5]","unit":"m"},{"name":"mode","typeHtml":"<a href=\"/docs/reference/types/ObstacleMode\">ObstacleMode</a>","doc":"Carve, relabel or avoid only.","default":"\"carve\"","options":["carve","area","avoid"]},{"name":"area","typeHtml":"u8","doc":"Area applied in <code>Area</code> mode, from 0 through 15.","default":"0","range":"0 – 15"}],"variants":[],"usedBy":{"types":[],"commands":[]},"usage":[{"label":"Add it","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> component.add </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p component</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">NavObstacle </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"Add NavObstacle\"</span></span></code></pre>"},{"label":"Set a field","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> property.set </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p path</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">NavObstacle.id </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p value</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-number)\">0</span><span style=\"color:var(--code-keyword)\"> --</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"Tune NavObstacle\"</span></span></code></pre>"},{"label":"In a scene document","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"NavObstacle\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"id\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-number)\">0</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">}</span></span></code></pre>"}]}
