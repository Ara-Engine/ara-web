{"name":"ReverbZone","kind":"component","module":"audio","doc":"A room or space with its own reverb. The listener&#39;s zone drives the room reverb; sources in other zones reach the listener through portals.","fields":[{"name":"name","typeHtml":"string","doc":"Unique zone name; portals, traces and diagnostics refer to zones by name.","default":"\"\""},{"name":"shape","typeHtml":"<a href=\"/docs/reference/types/ZoneShape\">ZoneShape</a>","doc":"Volume shape.","default":"\"box\"","options":["box","sphere"]},{"name":"position","typeHtml":"vec3","doc":"World-space center, supplied from the entity transform by the bridge.","default":"[0,0,0]","unit":"m"},{"name":"rotation","typeHtml":"vec4","doc":"World rotation as a unit quaternion (x, y, z, w), supplied by the bridge.","default":"[0,0,0,1]"},{"name":"halfExtents","typeHtml":"vec3","doc":"Box half extents.","default":"[5,3,5]","unit":"m"},{"name":"radius","typeHtml":"f32","doc":"Sphere radius.","default":"5","unit":"m","range":"0.1 – 10000"},{"name":"fade","typeHtml":"f32","doc":"Width inside the boundary over which the listener crossfades to the outer space.","default":"1","unit":"m","range":"0 – 100"},{"name":"priority","typeHtml":"i32","doc":"Nested zones: the highest priority containing zone wins.","default":"0"},{"name":"material","typeHtml":"<a href=\"/docs/reference/types/MaterialPreset\">MaterialPreset</a>","doc":"Wall material, deriving absorption for the realtime room model.","default":"\"generic\"","options":["generic","brick","concrete","ceramic","gravel","carpet","glass","plaster","wood","metal","rock"]},{"name":"rt60","typeHtml":"option&lt;vec3&gt;","doc":"Explicit low/mid/high reverberation times in seconds, overriding derived and baked values.","default":"null"},{"name":"wet","typeHtml":"f32","doc":"Reverb return gain.","default":"1","range":"0 – 4"},{"name":"earlyReflections","typeHtml":"bool","doc":"Geometric early reflections from the zone&#39;s walls.","default":"true"},{"name":"useBaked","typeHtml":