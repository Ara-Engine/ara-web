{"name":"RigidBody2d","kind":"component","module":"physics2d","doc":"Rigid-body authoring settings; simulation state is written to pose and velocity.","fields":[{"name":"motion","typeHtml":"<a href=\"/docs/reference/types/MotionType2d\">MotionType2d</a>","doc":"Static, kinematic, or dynamic motion.","default":"\"static\"","options":["static","kinematic","dynamic"]},{"name":"mass","typeHtml":"f32","doc":"Mass in kilograms; zero computes mass from the collider&#39;s 1 kg/m2 area density.","default":"0","unit":"kg","range":"≥ 0"},{"name":"allowSleep","typeHtml":"bool","doc":"Permit inactive bodies to sleep.","default":"true"},{"name":"continuous","typeHtml":"bool","doc":"Use swept collision detection for fast bodies.","default":"false"},{"name":"lockRotation","typeHtml":"bool","doc":"Prevent physical rotation, for upright props and platforms.","default":"false"}],"variants":[],"usedBy":{"types":["Physics2dSetParams"],"commands":["physics2d.set"]},"usage":[{"label":"Add it","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> component.add </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p component</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">RigidBody2d </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"Add RigidBody2d\"</span></span></code></pre>"},{"label":"Set a field","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);