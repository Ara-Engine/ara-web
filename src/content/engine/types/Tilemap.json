{"name":"Tilemap","kind":"component","module":"twoD","doc":"Canonical text source for a tilemap. Binary chunks are derived cache products.","fields":[{"name":"atlas","typeHtml":"option&lt;asset&gt;","doc":"Atlas asset reference; never a native descriptor.","default":"null"},{"name":"normalAtlas","typeHtml":"option&lt;asset&gt;","doc":"Optional normal atlas matching the source regions.","default":"null"},{"name":"layout","typeHtml":"<a href=\"/docs/reference/types/GridLayout\">GridLayout</a>","doc":"Grid, pointy hex or diamond layout.","default":"\"grid\"","options":["grid","hex","isometric"]},{"name":"cellSize","typeHtml":"vec2","doc":"World dimensions of a cell&#39;s bounding box in metres.","default":"[1,1]"},{"name":"definitions","typeHtml":"map&lt;<a href=\"/docs/reference/types/TileDefinition\">TileDefinition</a>&gt;","doc":"Tile number text to definitions; zero is reserved for empty cells.","default":"{}"},{"name":"layers","typeHtml":"keyed&lt;<a href=\"/docs/reference/types/TileLayer\">TileLayer</a>&gt;","doc":"Stable layers. Their array order never determines painter order.","default":"[]"},{"name":"rules","typeHtml":"list&lt;<a href=\"/docs/reference/types/TileRule\">TileRule</a>&gt;","doc":"Ordered auto-tiling rules.","default":"[]"}],"variants":[],"usedBy":{"types":["TilemapSetParams"],"commands":["tilemap.set"]},"usage":[{"label":"Add it","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> component.add </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p component</span><span style