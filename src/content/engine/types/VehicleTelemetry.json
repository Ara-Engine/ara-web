{"name":"VehicleTelemetry","kind":"component","module":"physics","doc":"Vehicle drivetrain and suspension state mirrored into ECS after each tick.","fields":[{"name":"wheelsInContact","typeHtml":"u32","doc":"Grounded wheel count.","default":"0","range":"0 – 4","replicate":"relevant, rollback"},{"name":"engineRpm","typeHtml":"f32","doc":"Current engine speed in revolutions per minute.","default":"0","range":"≥ 0","replicate":"relevant, rollback"},{"name":"gear","typeHtml":"i32","doc":"Gear index (negative is reverse).","default":"0","replicate":"relevant, rollback"}],"variants":[],"usedBy":{"types":[],"commands":[]},"usage":[{"label":"Add it","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> component.add </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p component</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">VehicleTelemetry </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"Add VehicleTelemetry\"</span></span></code></pre>"},{"label":"Set a field","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> property.set </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><