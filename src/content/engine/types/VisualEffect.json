{"name":"VisualEffect","kind":"component","module":"vfx","doc":"A GPU particle effect drawn at this entity. Presentation only: gameplay reads ara-vfx CPU events, never GPU particles. <code>effect</code> names a cooked library effect (<code>campfire</code>, <code>sparks</code>, <code>depth_sparks</code>, <code>magic_swirl</code>, <code>smoke</code>, <code>muzzle_flash</code>, <code>rain</code>, <code>dust</code>).","fields":[{"name":"effect","typeHtml":"string","doc":"Cooked library effect name.","default":"\"campfire\""},{"name":"scale","typeHtml":"f32","doc":"Uniform size: the effect&#39;s shape, sprite sizes and speeds grow together (2 doubles a campfire&#39;s height and spread).","default":"1","range":"0.05 – 50"},{"name":"intensity","typeHtml":"f32","doc":"Brightness multiplier on the effect&#39;s emitted and lit colour; its opacity is unchanged. Lower it for effects that glow too hot under a scene&#39;s exposure.","default":"1","range":"0 – 50"}],"variants":[],"usedBy":{"types":[],"commands":[]},"usage":[{"label":"Add it","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> component.add </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p component</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">VisualEffect </span><span style=\"color:var(--code-keyword)\">--</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"Add VisualEffect\"</span></span></code></pre>"},{"label":"Set a field","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">ara </span><span style=\"color:var(--code-keyword)\">do</span><span style=\"color:var(--code-fg)\"> property.set </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p entity</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">name:Crate </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p path</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-fg)\">VisualEffect.effect </span><span style=\"color:var(--code-keyword)\">-</span><span style=\"color:var(--code-fg)\">p value</span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-string)\">\"campfire\"</span><span style=\"color:var(--code-keyword)\"> --</span><span style=\"color:var(--code-fg)\">why </span><span style=\"color:var(--code-string)\">\"Tune VisualEffect\"</span></span></code></pre>"},{"label":"In a scene document","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">  \"VisualEffect\"</span><span style=\"color:var(--code-fg)\">: {</span></span>\n<span class=\"line\"><span style=\"color:var(--code-property)\">    \"effect\"</span><span style=\"color:var(--code-fg)\">: </span><span style=\"color:var(--code-string)\">\"campfire\"</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">  }</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">}</span></span></code></pre>"},{"label":"From C#","html":"<pre class=\"shiki ara\" style=\"background-color:var(--code-background);color:var(--code-fg)\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:var(--code-comment)\">/// &#x3C;</span><span style=\"color:var(--code-property)\">summary</span><span style=\"color:var(--code-comment)\">>Reduce a running particle effect intensity.&#x3C;/</span><span style=\"color:var(--code-property)\">summary</span><span style=\"color:var(--code-comment)\">></span></span>\n<span class=\"line\"><span style=\"color:var(--code-keyword)\">public</span><span style=\"color:var(--code-keyword)\"> static</span><span style=\"color:var(--code-keyword)\"> void</span><span style=\"color:var(--code-function)\"> UseVisualEffect</span><span style=\"color:var(--code-fg)\">(</span><span style=\"color:var(--code-type)\">Entity</span><span style=\"color:var(--code-fg)\"> entity, </span><span style=\"color:var(--code-keyword)\">in</span><span style=\"color:var(--code-type)\"> Tick</span><span style=\"color:var(--code-fg)\"> tick)</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">{</span></span>\n<span class=\"line\"><span style=\"color:var(--code-keyword)\">    ref</span><span style=\"color:var(--code-keyword)\"> var</span><span style=\"color:var(--code-fg)\"> component </span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-keyword)\"> ref</span><span style=\"color:var(--code-fg)\"> World.</span><span style=\"color:var(--code-function)\">Get</span><span style=\"color:var(--code-fg)\">&#x3C;</span><span style=\"color:var(--code-type)\">VisualEffect</span><span style=\"color:var(--code-fg)\">>(entity);</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">    component.Intensity </span><span style=\"color:var(--code-keyword)\">=</span><span style=\"color:var(--code-number)\"> 0.5f</span><span style=\"color:var(--code-fg)\">;</span></span>\n<span class=\"line\"><span style=\"color:var(--code-fg)\">}</span></span></code></pre>"}],"csharp":"VisualEffect"}
