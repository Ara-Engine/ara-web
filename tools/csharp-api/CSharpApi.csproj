<Project Sdk="Microsoft.NET.Sdk">

  <!-- Dumps Ara.Runtime's public C# API (signatures + XML docs) to JSON for the docs site.
       Run through `pnpm sync-engine`; not part of the site build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
  </ItemGroup>

</Project>
